datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}


model KnowledgeItem {
  id        String   @id @default(cuid())
  type      String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ApiSettings {
  id          String   @id @default(cuid())
  proxyUrl    String?
  apiKey      String
  model       String   @default("gpt-4o-mini")
  temperature Float    @default(0.7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
