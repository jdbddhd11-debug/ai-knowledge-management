datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String?
  name      String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  knowledgeItems KnowledgeItem[]
  spaces         Space[]
  aiConfigs      AIConfig[]
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  title     String?
  content   String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  spaces KnowledgeSpace[]
}

model Space {
  id          String   @id @default(cuid())
  name        String
  description String?
  spaceType   String   @default("topic")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  items KnowledgeSpace[]
}

model AIConfig {
  id          String   @id @default(cuid())
  proxyUrl    String
  apiKey      String
  model       String
  temperature Float    @default(0.7)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model KnowledgeSpace {
  knowledgeId String
  spaceId     String

  knowledge KnowledgeItem @relation(fields: [knowledgeId], references: [id], onDelete: Cascade)
  space     Space         @relation(fields: [spaceId], references: [id], onDelete: Cascade)

  @@id([knowledgeId, spaceId])
}

model ApiSettings {
  id          String   @id @default(cuid())
  proxyUrl    String?
  apiKey      String
  model       String   @default("gpt-4o-mini")
  temperature Float    @default(0.7)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
